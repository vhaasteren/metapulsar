{
  "name": "anpta dev",
  "image": "vhaasteren/anpta:cpu",
  "overrideCommand": false,
  "runArgs": [
    "--security-opt=seccomp=unconfined",
    "--security-opt=apparmor=unconfined"
  ],
  "containerEnv": {
    "HOST_UID": "${localEnv:UID}",
    "HOST_GID": "${localEnv:GID}",
    "HOME_OVERRIDE": "/workspaces/${localWorkspaceFolderBasename}/.home",
    "PYTHONUSERBASE": "/workspaces/${localWorkspaceFolderBasename}/.home/.local",
    "PYTHONPYCACHEPREFIX": "/workspaces/${localWorkspaceFolderBasename}/.home/.cache/pycache"
  },
  "remoteUser": "anpta",
  "updateRemoteUserUID": false,
  "remoteEnv": {
    "HOME": "${containerEnv:HOME_OVERRIDE}",
    "PATH": "${containerEnv:PYTHONUSERBASE}/bin:${containerEnv:PATH}",
    "DISPLAY": "host.docker.internal:0",
    "JUG_PG_USE_OPENGL": "false",
    "JUG_REMOTE_UI": "1",
    "LIBGL_ALWAYS_SOFTWARE": "1",
    "QSG_RHI_BACKEND": "software",
    "PINT_CLOCK_OVERRIDE": "${containerEnv:HOME_OVERRIDE}/pint-clock-override"
  },
  "workspaceFolder": "/workspaces/${localWorkspaceFolderBasename}",
  "onCreateCommand": "mkdir -p \"$HOME\" && git config --global --add safe.directory \"$PWD\" || true; bash \"$PWD/scripts/ensure_pint_clock_override.sh\" || true",
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "ms-python.black-formatter",
        "charliermarsh.ruff",
        "ms-toolsai.jupyter",
        "ms-toolsai.jupyter-keymap",
        "ms-toolsai.jupyter-renderers",
        "ms-python.vscode-pylance",
        "redhat.vscode-yaml",
        "eamodio.gitlens"
      ]
    }
  }
}
